<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <PackageId>Intrlay</PackageId>
    <Version>0.1.4</Version>
    <Description>Typed storage for generated Intrlay memory views</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>Apache-2.0 OR MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/soulart/intrlay</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/soulart/intrlay</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="generator/**/*.cs" />
    <ProjectReference Include="generator/Intrlay.Generator.csproj" ReferenceOutputAssembly="false" />
    <None Include="generator/bin/$(Configuration)/netstandard2.0/Intrlay.Generator.dll"
          Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="/" Condition="Exists('CHANGELOG.md')" />
    <None Include="LICENSE*" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
