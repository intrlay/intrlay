<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FixtureDirectory>native-views</FixtureDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestCSharp15)' == 'true'">
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <FixtureDirectory>native-views-csharp15</FixtureDirectory>
    <DefineConstants>$(DefineConstants);INTRLAY_CSHARP15</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestIncompleteUnion)' == 'true'">
    <DefineConstants>$(DefineConstants);INTRLAY_INCOMPLETE_UNION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestWrongUnionLanguage)' == 'true'">
    <LangVersion>14</LangVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestMissingUnionRuntime)' == 'true'">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestInvalidSources)' == 'true'">
    <DefineConstants>$(DefineConstants);INTRLAY_TEST_INVALID_SOURCES</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/csharp/Intrlay.csproj" />
    <ProjectReference Include="../../packages/csharp/generator/Intrlay.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../../target/$(FixtureDirectory)/bindings.cs" />
  </ItemGroup>
</Project>
