<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <FixtureDirectory>native-union-depth</FixtureDirectory>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TestCSharp15)' == 'true'">
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15</LangVersion>
    <FixtureDirectory>native-union-depth-csharp15</FixtureDirectory>
    <DefineConstants>$(DefineConstants);INTRLAY_CSHARP15</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <CompilerGeneratedFilesOutputPath>../../target/$(FixtureDirectory)/expanded</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../packages/csharp/Intrlay.csproj" />
    <ProjectReference Include="../../packages/csharp/generator/Intrlay.Generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <Compile Include="../../target/$(FixtureDirectory)/bindings.cs" />
  </ItemGroup>
</Project>
