error[E0502]: cannot borrow `bytes` as mutable because it is also borrowed as immutable
  --> tests/ui/fail/overlapping_checked_views.rs:9:50
   |
 8 |     let shared = PacketView::from_bytes(&bytes[..]).unwrap();
   |                                          ----- immutable borrow occurs here
 9 |     let _exclusive = PacketView::from_bytes(&mut bytes[..]).unwrap();
   |                                                  ^^^^^ mutable borrow occurs here
10 |     // The earlier shared view remains live across the exclusive borrow.
11 |     let _ = shared.value();
   |             ------ immutable borrow later used here
